# CampusVault Backend Environment Variables
PORT=5000
AWS_REGION=ap-south-1
S3_BUCKET=campusvault-storage-bucket
ADMIN_PIN=Admin@1234
MAX_FILE_MB=10

# Optional: Only required if NOT using AWS EC2 IAM Role
# (e.g., when testing locally on your computer with an IAM User)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
